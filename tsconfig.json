{
	"compileOnSave": false,
	"compilerOptions": {
		"forceConsistentCasingInFileNames": true,
		"rootDir": ".",
		"outDir": "./bin",
		"sourceMap": true,
		"declaration": false,
		"declarationMap": false,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "es2024",
		"lib": ["es2024"],
		"types": ["node"],
		"importHelpers": false,
		"strict": true,
		"noImplicitOverride": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"allowJs": true,
		"checkJs": false
	},
	"include": ["./src/**/*.ts", "./src/**/*.cts", "./*.d.ts", "./lib/**/*.js", "./pdfparser.js"],
	"exclude": ["./lib/pdfjs-code.js"]
}
